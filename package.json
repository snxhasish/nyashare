{
  "name": "nyashare",
  "version": "0.0.3",
  "description": "CLI tool to share files over local network",
  "main": "dist/index.js",
  "bin": {
    "nyashare": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "diagnose": "DEBUG=true ts-node src/diagnostic.ts",
    "diagnose:build": "npm run build && DEBUG=true node dist/diagnostic.js"
  },
  "keywords": [
    "cli",
    "file-sharing",
    "local-network",
    "p2p"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.0",
    "inquirer-file-tree-selection-prompt": "^2.0.5",
    "ip": "^1.1.8",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/ip": "^1.1.3",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ]
}
